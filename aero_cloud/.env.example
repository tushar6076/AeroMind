# ======================
# Project
# ======================
PROJECT_NAME=AeroMind
ENVIRONMENT=development

# ======================
# Server
# ======================
HOST=0.0.0.0
PORT=8100
DEBUG=false

# ======================
# Security
# ======================
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# Database (Neon)
# ======================
DATABASE_URL=postgaerol://neondb_owner:<password>@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgaerol://neondb_owner:<password>@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# ======================
# Redis (Upstash)
# ======================
REDIS_URL=redis://default:<password>@<upstash-host>:<port>

# ======================
# CORS
# ======================
# Since multiple mobile apps will connect, we can allow all in development
# In production, restrict properly
BACKEND_CORS_ORIGINS=["*"]

# ======================
# Email (SMTP)
# ======================
MAIL_USERNAME=your_email_username_here
MAIL_PASSWORD=your-titan-mailbox-password
MAIL_FROM=your_email_from_address
MAIL_FROM_NAME=your_email_from_name
MAIL_SERVER=smtp.titan.email
MAIL_PORT=587
# use 465 for SSL and 587 for TLS

# ======================
# AI Keys
# ======================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here

# ======================
# Admin
# ======================
ADMIN_EMAIL=your_admin_email_here

# ======================
# Local GCS / Flight Hardware
# ======================
# Replace with a long random value. Enter the same value in the Flutter app.
API_ACCESS_TOKEN=replace_with_a_long_random_token

# ELRS transmitter serial interface speaking CRSF.
# Prefer /dev/serial/by-id/... to unstable /dev/ttyUSBx names.
ELRS_SERIAL_PORT=
ELRS_BAUD_RATE=420000

# Must match the FC's configured arm switch channel. Leave unset until verified.
# Leave unset until the flight controller's arming switch channel is verified.
# ELRS_ARM_CHANNEL=5
ELRS_ARMED_CHANNEL_VALUE=1811

# UVC capture interface fed by the RX5808 receiver and USB HDMI capture card.
VIDEO_INPUT_DEVICE=/dev/video0
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FRAME_RATE=30
HOST_THERMAL_PATH=/sys/class/thermal/thermal_zone0/temp